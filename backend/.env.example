# Configuracion de Supabase (reemplaza a MySQL).
# URL del proyecto: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=

# Clave "publishable" (anon) de Supabase.
SUPABASE_PUBLISHABLE_KEY=

# Clave SERVICE ROLE del backend. Se obtiene en Project Settings -> API
# -> Service Role. Nunca se debe exponer en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticacion JWT propia del backend.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Puerto del servidor Express.
PORT=5000